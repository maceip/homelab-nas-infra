[Unit]
Description=Public and tailnet HTTPS gateway
After=network.target
[Service]
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
EnvironmentFile=/etc/pi-gateway/upload-secret.env
ExecStart=/usr/bin/caddy run --config /etc/pi-gateway/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/caddy
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
