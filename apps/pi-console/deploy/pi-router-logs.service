[Unit]
Description=Archer LAN-only local-delivery log receiver
After=network-online.target
Wants=network-online.target
[Service]
User=pi
Group=pi
Environment=PI_OBSERVABILITY_DIR=/var/lib/pi-observability
Environment=PI_LOG_BIND=192.168.0.56
ExecStart=/usr/bin/python3 /opt/pi-observability/telemetry.py smtp
Restart=on-failure
RestartSec=10
StateDirectory=pi-observability
StateDirectoryMode=0750
UMask=0027
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressDeny=any
IPAddressAllow=192.168.0.1/32
MemoryMax=128M
TasksMax=32
[Install]
WantedBy=multi-user.target
