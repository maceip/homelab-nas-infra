[Unit]
Description=Pi metrics and explainable security activity collector
After=network.target
[Service]
User=pi
Group=pi
SupplementaryGroups=systemd-journal
Environment=PI_OBSERVABILITY_DIR=/var/lib/pi-observability
ExecStart=/usr/bin/python3 /opt/pi-observability/telemetry.py collect
Restart=on-failure
RestartSec=10
StateDirectory=pi-observability
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=192M
TasksMax=32
[Install]
WantedBy=multi-user.target
