[Unit]
Description=File Browser
Documentation=https://filebrowser.org/
After=network.target srv-storage.mount
RequiresMountsFor=/srv/storage/public

[Service]
Type=simple
User=nas-share
Group=nas-share
StateDirectory=filebrowser
WorkingDirectory=/var/lib/filebrowser
ExecStart=/usr/local/bin/filebrowser \
  --database /var/lib/filebrowser/filebrowser.db \
  --root /srv/storage/public \
  --address 0.0.0.0 \
  --port 8080 \
  --auth.method noauth \
  --disableExec
Restart=on-failure
RestartSec=3s

# Same home-LAN sources as Samba hosts allow. systemd applies this to
# incoming packets even if the process binds IPv4 and IPv6.
IPAddressAllow=localhost
IPAddressAllow=link-local
IPAddressAllow=192.168.0.0/16

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ReadWritePaths=/srv/storage/public /var/lib/filebrowser
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
